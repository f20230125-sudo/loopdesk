# Local: create instance directory, then run python -m flask --app app migrate
DATABASE_URL=sqlite:///instance/loopdesk.sqlite3
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# production requires PostgreSQL, a strong SECRET_KEY and HTTPS
APP_ENV=development

# Required for production: replace with the exact approved deployment/custom hostnames.
# LOOPDESK_TRUSTED_HOSTS=your-project.vercel.app,your-domain.example
# Optional fixed FollowDesk origin shown on the outreach connection page.
# Local default: http://127.0.0.1:5059; production has no default link.
# LOOPDESK_FOLLOWDESK_URL=https://your-followdesk-project.vercel.app
